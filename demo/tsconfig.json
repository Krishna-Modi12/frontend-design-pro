{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "**/*.tsx",
    "**/*.ts",
    "_stubs.d.ts"
  ],
  "exclude": [
    "showcase",
    "landing-page",
    "**/node_modules"
  ]
}
