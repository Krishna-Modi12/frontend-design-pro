# Build output — archives are attached to GitHub Releases, not committed
dist/
*.skill

# Node
node_modules/
npm-debug.log*

# Screenshot harness build output — the images it produces are committed under
# demo/, the machinery that produces them is not.
tools/screenshots/.next/
tools/screenshots/next-env.d.ts

# visual-regression.mjs run output — diff images and the JSON summary are
# per-run scratch, regenerated every invocation. Only tools/screenshots/baselines/
# is the committed artifact.
tools/screenshots/.diff-output/
tools/screenshots/visual-regression-report.json

# Python
__pycache__/
*.py[cod]
.venv/

# Locally composed Pages upload and the images `pages:verify` writes beside it.
# The real upload is built by .github/workflows/pages.yml on the runner and is
# never committed; these are its local stand-ins.
site-check/
site-check-*.png

# Generated / transient
tsconfig.tests.json
tsconfig.golds.*.json
*.tsbuildinfo
.DS_Store
*.tmp
*.bak
*.draft

# Agent scratch worktrees
.claude/
