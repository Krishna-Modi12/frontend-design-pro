# React must exist exactly once across this repo.
#
# The root installs it because vitest renders components. This package declares
# `next`, which lists react/react-dom as peers, and npm 7+ installs peers
# automatically — giving the harness a second copy. Files under demo/ then
# resolve React from the root while files here resolve their own, and a render
# tree spanning two React instances dies in dev with "Cannot read properties of
# undefined (reading 'recentlyCreatedOwnerStacks')". Production builds stay
# green throughout, which is what makes it easy to miss.
#
# Suppressing peer auto-install leaves exactly one React — the root's — which
# every file reaches by walking up.
legacy-peer-deps=true
